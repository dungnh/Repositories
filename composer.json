{
    "name": "coliving/repositories",
    "description": "Flexible Laravel 8.x through 13.x repository library.",
    "keywords": [
        "league",
        "repository"
    ],
    "homepage": "https://github.com/dungnh/Repositories",
    "license": "MIT",
    "authors": [
        {
            "name": "Dzung Nguyen",
            "email": "dungnh@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3 | ^8.4",
        "illuminate/contracts": "^8.0 | ^9.0 | ^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/database": "^8.0 | ^9.0 | ^10.0 | ^11.0 | ^12.0 | ^13.0"
    },
    "require-dev": {
        "scrutinizer/ocular": "~1.1",
        "phpunit/phpunit": "9.* | 10.* | 11.*",
        "orchestra/testbench": "^8.1 | ^9.0 | ^10.0 | ^11.0 | ^12.0 | ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SebastianBerc\\Repositories\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SebastianBerc\\Repositories\\Test\\": "tests"
        },
        "classmap": [
            "tests/migrations"
        ]
    },
    "scripts": {
        "test": "phpunit"
    }
}
